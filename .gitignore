# Build output
target/
# The CLI scratch output directory, repo root only. Anchored so it does not match a
# 'generated' path segment deep in the tree (for example a golden fixture whose expected
# output lives under a com/tibyaan/generated package).
/generated/
*.class
*.jar
*.war

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Maven
.mvn/wrapper/maven-wrapper.jar

# Logs
*.log

# H2 database files
*.db
*.mv.db
*.trace.db
/examples/pms-backend
/examples/erp-backend
/examples/as-backend
/tibyaan-site

# Local secrets: the ANTHROPIC_API_KEY for tibyan describe, loaded into the environment by the shell, never read by the tool
.env
