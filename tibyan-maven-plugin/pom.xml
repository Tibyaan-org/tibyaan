<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tibyaan.org</groupId>
        <artifactId>tibyaan</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>tibyan-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>Tibyaan Maven Plugin</name>
    <description>Runs the existing pipeline at build time so the capabilities manifest is generated onto the classpath.</description>

    <properties>
        <maven.api.version>3.9.15</maven.api.version>
        <maven.plugin.tools.version>3.15.1</maven.plugin.tools.version>
    </properties>

    <!--
      This module is Maven wiring only (Volume 11). It holds no generation logic: the Mojo invokes
      the existing TibyanCompiler, SpringCapabilityProvider, and McpBackend, the same code the CLI
      uses, so build-time output cannot drift from the CLI. By default it runs the resilient scan
      (matching `tibyan scan`, Volume 11 section 3.1.1) so adoption cannot break a build; a
      strict=true opt-in matches `tibyan generate`. It depends on the pipeline and the two plugins it
      composes, plus the Maven plugin API (provided by the running Maven).
    -->
    <dependencies>
        <dependency>
            <groupId>io.github.tibyaan.org</groupId>
            <artifactId>tibyan-pipeline</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.tibyaan.org</groupId>
            <artifactId>tibyan-provider-spring</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.tibyaan.org</groupId>
            <artifactId>tibyan-backend-mcp</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven.plugin.tools.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${maven.plugin.tools.version}</version>
            </plugin>
        </plugins>
    </build>

</project>
