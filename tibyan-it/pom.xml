<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tibyaan.org</groupId>
        <artifactId>tibyaan</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>tibyan-it</artifactId>
    <name>Tibyaan Integration Tests</name>
    <description>End-to-end test of the full path against the real example app. Test harness only.</description>

    <!-- A test harness, never published (docs/RELEASING.md), and no sources or javadoc jars. -->
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
    </properties>

    <!--
      Volume 12: tibyan-it tests across modules end to end and is depended on by nothing. It runs
      the real provider and backend in process to generate the tools, then starts the unmodified
      example app as a separate process and drives it over the genuine MCP protocol. The end-to-end
      test is a failsafe IT, run in the verify phase after the example app jar is packaged.
    -->
    <dependencies>
        <dependency>
            <groupId>io.github.tibyaan.org</groupId>
            <artifactId>tibyan-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.tibyaan.org</groupId>
            <artifactId>tibyan-plugin-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.tibyaan.org</groupId>
            <artifactId>tibyan-provider-spring</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.tibyaan.org</groupId>
            <artifactId>tibyan-backend-mcp</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- The CLI, exercised in process by the end-to-end test to scan and generate. -->
        <dependency>
            <groupId>io.github.tibyaan.org</groupId>
            <artifactId>tibyan-cli</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Brings the MCP client SDK (io.modelcontextprotocol) transitively for the genuine protocol. -->
        <dependency>
            <groupId>io.github.tibyaan.org</groupId>
            <artifactId>tibyan-runtime-spring</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
