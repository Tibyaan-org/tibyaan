<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tibyaan-org</groupId>
        <artifactId>tibyaan</artifactId>
        <version>0.4.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>legacy-spring-app</artifactId>
    <name>Legacy Spring App (Example)</name>
    <description>Example legacy Spring application for the technical spike</description>

    <!-- An example app, never published (docs/RELEASING.md). It also builds no sources or javadoc
         jars under the release profile: those are only for published artifacts, and an extra
         non-runnable jar in this module's target would confuse the end-to-end test's launch of the
         real app jar. -->
    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <tibyan.skip.publishing>true</tibyan.skip.publishing>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- The one dependency that modernizes this app -->
        <dependency>
            <groupId>io.github.tibyaan-org</groupId>
            <artifactId>tibyan-runtime-spring</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Build-time generation: the tibyan-maven-plugin scans this app's own source and writes
              tibyan/capabilities.json onto the classpath (target/classes), so no one runs
              `tibyan generate` by hand or commits the manifest. It runs the same pipeline the CLI
              does, so the output matches `tibyan generate` byte for byte.
            -->
            <plugin>
                <groupId>io.github.tibyaan-org</groupId>
                <artifactId>tibyan-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>generate-tibyan-manifest</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
