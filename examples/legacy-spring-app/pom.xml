<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tibyaan</groupId>
        <artifactId>tibyaan</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>legacy-spring-app</artifactId>
    <name>Legacy Spring App (Example)</name>
    <description>Example legacy Spring application for the technical spike</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- The one dependency that modernizes this app -->
        <dependency>
            <groupId>com.tibyaan</groupId>
            <artifactId>tibyan-runtime-spring</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Build-time generation: the tibyan-maven-plugin scans this app's own source and writes
              tibyan/capabilities.json onto the classpath (target/classes), so no one runs
              `tibyan generate` by hand or commits the manifest. It runs the same pipeline the CLI
              does, so the output matches `tibyan generate` byte for byte.
            -->
            <plugin>
                <groupId>com.tibyaan</groupId>
                <artifactId>tibyan-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>generate-tibyan-manifest</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
