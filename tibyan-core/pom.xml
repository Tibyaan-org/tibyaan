<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tibyaan.org</groupId>
        <artifactId>tibyaan</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>tibyan-core</artifactId>
    <name>Tibyaan Core</name>
    <description>The Capability IR and its semantic validation. Zero external runtime dependencies.</description>

    <!--
      Hard rule (CLAUDE.md, Volume 12 section 5): tibyan-core depends on nothing at
      compile or runtime. Not Spring, not JavaParser, not an MCP library, not even Jackson.
      The dependencies below are all test scope only, so the shipped artifact stays
      dependency free. Jackson is here purely to prove the IR round-trips to JSON and back
      (Volume 4 section 6); when JSON becomes a real feature it lives in a non-core module.
      Verify with: mvn -pl tibyan-core dependency:tree (no compile or runtime entries).
    -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
