<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tibyaan</groupId>
        <artifactId>tibyaan</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>tibyan-pipeline</artifactId>
    <name>Tibyaan Pipeline</name>
    <description>Orchestrates provide, validate, generate. Composes plugins through their interfaces.</description>

    <!--
      Volume 9 and Volume 12 section 5: the pipeline depends on tibyan-plugin-api and tibyan-core
      only. It holds no provider, backend, or runtime logic; it composes them through the plugin
      interfaces, and the concrete plugins are injected by the caller (the CLI). Jackson is here
      to read and write the IR as inspectable JSON, the productionized form of the serializer P0
      kept in test scope; it is a non-core module, so Jackson is allowed.
    -->
    <dependencies>
        <dependency>
            <groupId>com.tibyaan</groupId>
            <artifactId>tibyan-plugin-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tibyaan</groupId>
            <artifactId>tibyan-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
