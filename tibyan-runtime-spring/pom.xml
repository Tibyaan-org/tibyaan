<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tibyaan-org</groupId>
        <artifactId>tibyaan</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>tibyan-runtime-spring</artifactId>
    <name>Tibyaan Runtime Spring</name>
    <description>Spring Boot starter that hosts an MCP server inside the application context</description>

    <dependencies>
        <!--
          The runtime hosts and binds (Volume 7). It depends on tibyan-plugin-api and
          tibyan-core only (Volume 12 section 5), plus its host framework, Spring and Spring AI.
          It depends on no provider and no backend: it reads the generated capabilities manifest,
          never the source or the generator.
        -->
        <dependency>
            <groupId>io.github.tibyaan-org</groupId>
            <artifactId>tibyan-plugin-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.tibyaan-org</groupId>
            <artifactId>tibyan-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
