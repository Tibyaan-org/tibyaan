<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.tibyaan-org</groupId>
        <artifactId>tibyaan</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>tibyan-runtime-spring</artifactId>
    <name>Tibyaan Runtime Spring</name>
    <description>Spring Boot starter that hosts an MCP server inside the application context</description>

    <dependencies>
        <!--
          The runtime hosts and binds (Volume 7). It depends on tibyan-plugin-api and
          tibyan-core only (Volume 12 section 5), plus its host framework, Spring and Spring AI.
          It depends on no provider and no backend: it reads the generated capabilities manifest,
          never the source or the generator.
        -->
        <dependency>
            <groupId>io.github.tibyaan-org</groupId>
            <artifactId>tibyan-plugin-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.tibyaan-org</groupId>
            <artifactId>tibyan-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <!-- Phase SEC-1 (Volume 7 section 15): optional, so a host without Spring Security still starts; the runtime
             touches it only when the class is present. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Spike SEC-0: a real servlet host with Spring Security, for the caller-boundary tests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            Only tibyan/runtime-version.properties is filtered, so ${project.version} becomes the
            module's real version. Everything else, notably the Spring autoconfiguration metadata
            under META-INF, is copied verbatim: filtering it would be a silent hazard the day one of
            those files contains a ${...} token of its own.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>tibyan/runtime-version.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>tibyan/runtime-version.properties</include>
                </includes>
            </resource>
        </resources>
    </build>

</project>
